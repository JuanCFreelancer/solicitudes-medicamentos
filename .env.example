# Copia este archivo a .env y ajusta los valores.  NUNCA subas .env al repositorio.

# --- PostgreSQL ---
POSTGRES_DB=medicamentos
POSTGRES_USER=app
POSTGRES_PASSWORD=cambia_esta_password

# --- JWT (mismo valor en los tres servicios) ---
# Mínimo 32 caracteres. Generar uno: openssl rand -base64 48
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio_de_al_menos_32_chars
JWT_EXPIRATION_MINUTES=60

# --- CORS: origen permitido del frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Integración con notificaciones-service (opcional) ---
# NOTIFICATIONS_ENABLED=false  desactiva la notificación: solicitudes funciona de forma autónoma.
# NOTIFICATIONS_TIMEOUT=2s     tiempo máximo de espera antes de degradar a NO_DISPONIBLE.
